# Facultatif pour le shell J1. Les deux valeurs sont obligatoires ensemble
# avant toute utilisation de Supabase. Copier les valeurs LOCALES de npm run db:status.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement. Ne jamais utiliser de préfixe NEXT_PUBLIC pour ces valeurs.
SUPABASE_SECRET_KEY=
# Secret aléatoire d'au moins 32 caractères pour les compteurs anonymisés.
AUTH_RATE_LIMIT_SECRET=
# J6 : secret HTTP aléatoire d’au moins 32 caractères. L’ancien reste facultatif pendant une rotation.
JOBS_SECRET=
JOBS_SECRET_PREVIOUS=
# Seule la clé VAPID publique est exposable. Sans ces trois valeurs, la boîte interne fonctionne seule.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Ne jamais exposer une clé secrète ou service_role dans NEXT_PUBLIC_*.
