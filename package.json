{
  "name": "on-joue-quand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-local-env.mjs node_modules/@playwright/test/cli.js test",
    "test:integration": "node --test --test-concurrency=1 tests/integration/identity.test.mjs tests/integration/availability.test.mjs tests/integration/games.test.mjs tests/integration/sessions.test.mjs tests/integration/notifications.test.mjs tests/integration/operations.test.mjs tests/integration/retention.test.mjs tests/integration/evenings.test.mjs",
    "test:notifications": "node --test tests/integration/notifications.test.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "test:ops": "node --test tests/ops/backup.test.mjs tests/ops/monitor.test.mjs tests/ops/backup-age.test.mjs tests/ops/mailbox-code.test.mjs tests/ops/bootstrap-preprod.test.mjs",
    "ops:monitor": "node scripts/ops/monitor.mjs",
    "backup:create": "node scripts/ops/backup.mjs",
    "backup:rehearse": "node scripts/ops/rehearse-local.mjs",
    "test:sessions": "node --test tests/integration/sessions.test.mjs",
    "test:games": "node --test tests/integration/games.test.mjs",
    "test:availability": "node --test tests/integration/availability.test.mjs",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "bootstrap:preprod": "node scripts/bootstrap-preprod.mjs",
    "env:local": "node scripts/configure-local.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:migrate": "supabase migration up --local",
    "db:types": "supabase gen types typescript --local"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
